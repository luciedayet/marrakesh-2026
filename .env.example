# Copy to .env for local dev (`vercel dev` loads it automatically).
# In production, set these as Environment Variables in the Vercel project
# settings instead — never commit real values to git.

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# JSON map of 4-digit access codes -> { name, fullAccess }.
# fullAccess:true sees prices/budget/finance, fullAccess:false gets them
# masked. These are placeholder values — replace with your own.
ACCESS_CODES={"0000":{"name":"Demo","fullAccess":true},"1111":{"name":"Invite","fullAccess":false}}

# Optional: how long a login stays valid, in days (default 60).
SESSION_MAX_AGE_DAYS=60
